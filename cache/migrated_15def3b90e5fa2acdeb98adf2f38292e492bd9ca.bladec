<?php  $this->startComponent('templates.main'); ?>

 <?php  $this->slot('title'); ?>
 Historial de actualizaciones SIGA
 <?php  $this->endSlot(); ?>

 <?php  $this->slot('header'); ?>
 <style>
 .page-scroll { overflow-x: auto; width: 100%; }
 table { min-width: 1200px; }
 th, td {
 white-space: nowrap;
 text-align: center;
 vertical-align: middle;
 height: 46px;
 }
 .badge-graduado   { background: #198754; color: #fff; }
 .badge-nograduado { background: #6c757d; color: #fff; }
 </style>
 <?php  $this->endSlot(); ?>

 <?php /* TOAST */ ?>
 <?php if(!empty($message)): ?>
 <div class="toast align-items-center text-bg-success border-0 position-fixed top-0 end-0 m-3"
 role="alert" aria-live="assertive" aria-atomic="true">
 <div class="d-flex">
 <div class="toast-body"><?php echo \htmlentities($message??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <button type="button" class="btn-close btn-close-white me-2 m-auto"
 data-bs-dismiss="toast"></button>
 </div>
 </div>
 <?php endif; ?>

 <div class="page-scroll">

 <h1 class="text-center mb-1">Historial de actualizaciones SIGA</h1>
 <p class="text-center text-muted mb-4">
 <?php echo \htmlentities(number_format($total)??'', ENT_QUOTES, 'UTF-8', false); ?> registro(s) ya enviados a SIGA.
 </p>

 <?php /* BUSCADOR */ ?>
 <form method="GET" class="mb-4 d-flex justify-content-center">
 <input type="text" name="search" value="<?php echo \htmlentities($search ?? ''??'', ENT_QUOTES, 'UTF-8', false); ?>"
 class="form-control w-50"
 placeholder="Buscar por cédula, nombre, correo, ciudad...">
 <button class="btn btn-primary ms-2">Buscar</button>
 </form>

 <table class="table table-striped table-hover table-sm">
 <thead class="table-dark">
 <tr>
 <th>#ID</th>
 <th>Cédula</th>
 <th>Nombre</th>
 <th>Apellido</th>
 <th>Correo</th>
 <th>Teléfono</th>
 <th>Ciudad</th>
 <th>Estado SIGA</th>
 <th>Actualizado por</th>
 <th>Fecha actualización</th>
 </tr>
 </thead>

 <tbody>
 <?php $__empty_1 = true; foreach($migratedAnswers as $row): $__empty_1 = false; ?>
 <tr>
 <td class="text-muted small"><?php echo \htmlentities($row['id']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><strong><?php echo \htmlentities($row['identification_number']??'', ENT_QUOTES, 'UTF-8', false); ?></strong></td>
 <td><?php echo \htmlentities($row['name']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($row['last_name']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($row['email'] ?: '—'??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($row['mobile_phone'] ?: '—'??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($row['city'] ?: '—'??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td>
 <?php if($row['is_graduated'] == 1): ?>
 <span class="badge badge-graduado">Graduado</span>
 <?php elseif($row['is_graduated'] == 0): ?>
 <span class="badge badge-nograduado">No graduado</span>
 <?php else: ?>
 <span class="badge bg-warning text-dark">Pendiente</span>
 <?php endif; ?>
 </td>
 <td><?php echo \htmlentities($row['migrated_by_name'] ?: '—'??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($row['updated_at']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 </tr>
 <?php endforeach; if ($__empty_1): ?>
 <tr>
 <td colspan="10" class="text-center text-muted py-4">
 No hay registros actualizados en SIGA aún.
 </td>
 </tr>
 <?php endif; ?>
 </tbody>
 </table>

 <?php /* PAGINACIÓN */ ?>
 <?php if($totalPages > 1): ?>
 <nav class="d-flex justify-content-center mt-4">
 <ul class="pagination">
 <li class="page-item <?php echo \htmlentities($page <= 1 ? 'disabled' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <a class="page-link" href="?page=<?php echo \htmlentities($page - 1??'', ENT_QUOTES, 'UTF-8', false); ?>&search=<?php echo \htmlentities($search??'', ENT_QUOTES, 'UTF-8', false); ?>">«</a>
 </li>

 <?php for($i = max(1, $page - 3); $i <= min($totalPages, $page + 3); $i++): ?>
 <li class="page-item <?php echo \htmlentities($i == $page ? 'active' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <a class="page-link" href="?page=<?php echo \htmlentities($i??'', ENT_QUOTES, 'UTF-8', false); ?>&search=<?php echo \htmlentities($search??'', ENT_QUOTES, 'UTF-8', false); ?>"><?php echo \htmlentities($i??'', ENT_QUOTES, 'UTF-8', false); ?></a>
 </li>
 <?php endfor; ?>

 <li class="page-item <?php echo \htmlentities($page >= $totalPages ? 'disabled' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <a class="page-link" href="?page=<?php echo \htmlentities($page + 1??'', ENT_QUOTES, 'UTF-8', false); ?>&search=<?php echo \htmlentities($search??'', ENT_QUOTES, 'UTF-8', false); ?>">»</a>
 </li>
 </ul>
 </nav>
 <?php endif; ?>

 </div>

 <?php  $this->slot('scripts'); ?>
 <script>
 document.addEventListener('DOMContentLoaded', function () {
 document.querySelectorAll('.toast').forEach(el => {
 new bootstrap.Toast(el, { delay: 5000 }).show();
 });
 });
 </script>
 <?php  $this->endSlot(); ?>

<?php echo $this->renderComponent(); ?>
